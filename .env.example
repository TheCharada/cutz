DATABASE_URL=postgresql://cutz:cutz@localhost:5432/cutz
TEST_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
DEFAULT_PHONE_COUNTRY=BR
OTP_SECRET=

# Number of reverse-proxy hops trusted to append X-Forwarded-For. Keep 0 without a known proxy chain.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Trust X-Real-IP only when a trusted reverse proxy overwrites this header with the client IP.
# When true, X-Forwarded-For is ignored for IP rate limiting.
RATE_LIMIT_TRUST_X_REAL_IP=false
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_MODERATE_MAX=30
RATE_LIMIT_MODERATE_WINDOW_MS=60000
RATE_LIMIT_LOOSE_MAX=120
RATE_LIMIT_LOOSE_WINDOW_MS=60000
MAX_FUTURE_APPOINTMENTS_PER_CUSTOMER=5
MAX_ACTIVE_WAITLIST_ENTRIES_PER_CUSTOMER=5

# Meta webhook settings belong to the web service. The verify token is chosen by us and entered
# in Meta's webhook setup; the app secret comes from the Meta app and validates POST signatures.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

MESSAGING_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_APPOINTMENT_CREATED=
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=
WHATSAPP_TEMPLATE_WAITLIST_ENTRY_CREATED=
WHATSAPP_TEMPLATE_WAITLIST_OFFER=
WHATSAPP_TEMPLATE_CUSTOMER_OTP=
NOTIFICATION_POLL_MS=1000
WAITLIST_POLL_MS=1000
WAITLIST_ENTRY_SWEEP_MS=60000
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_CONCURRENCY=5
PROCESSING_LEASE_MS=120000
RECOVERY_INTERVAL_MS=60000
PROVIDER_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=20000
DB_ERROR_BACKOFF_MS=5000

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
